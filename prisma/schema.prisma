// Abol Store - Prisma schema
// Prisma 7 with driver adapters. Datasource URL is configured in prisma.config.ts,
// NOT here. SQLite for local dev; designed to migrate to PostgreSQL later.
//
// NOTE: SQLite does not support native enums, so status/type fields use String
// with documented allowed values. This is intentional and keeps order workflows,
// inventory modes, and roles configurable in the future without a schema rewrite.
// All money amounts are integers in Toman (تومان) to avoid float rounding errors.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Users & Auth
// ----------------------------------------------------------------------------

// role: "CUSTOMER" | "ADMIN" (more roles can be added later, e.g. SUPPORT, PRODUCT_MANAGER)
model User {
  id              String    @id @default(cuid())
  phone           String    @unique
  passwordHash    String
  name            String?
  role            String    @default("CUSTOMER")
  isActive        Boolean   @default(true)
  isPhoneVerified Boolean   @default(false) // manual verification by admin for now
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        Session[]
  orders          Order[]
  reviews         Review[]
  supportMessages SupportMessage[]

  @@index([role])
}

// Only a hashed session token is ever stored, never the raw token.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

// type: "CP" | "ACCOUNT" | "COMBO"
// inventoryMode: "UNLIMITED" | "STATUS_ONLY" | "EXACT_QUANTITY"
model Product {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  shortDescription   String?
  fullDescription    String?
  price              Int // Toman
  compareAtPrice     Int? // Toman, for showing discounts
  type               String   @default("CP")
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id])
  isActive           Boolean  @default(true)
  isFeatured         Boolean  @default(false)
  isBestSelling      Boolean  @default(false)
  inventoryMode      String   @default("UNLIMITED")
  inStock            Boolean  @default(true) // used when inventoryMode = STATUS_ONLY
  quantity           Int? // used when inventoryMode = EXACT_QUANTITY
  cancellationPolicy String? // per-product cancellation/refund rules
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  media          ProductMedia[]
  attributes     ProductAttribute[]
  checkoutFields ProductCheckoutField[]
  orderItems     OrderItem[]
  reviews        Review[]

  @@index([type])
  @@index([categoryId])
  @@index([isActive, isFeatured])
}

// type: "IMAGE" | "VIDEO"
model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  type      String  @default("IMAGE")
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

// Flexible admin-defined product properties (e.g. region, level, skins, guns).
model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String // machine key e.g. "region"
  label     String // display label e.g. "ریجن"
  value     String
  sortOrder Int     @default(0)

  @@index([productId])
}

// Configurable checkout fields per product. By default no fields ask for game
// account email/password. Game credentials are NEVER stored in this system.
// fieldType: "TEXT" | "TEXTAREA" | "NUMBER" | "EMAIL" | "SELECT"
model ProductCheckoutField {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label       String
  fieldKey    String
  fieldType   String  @default("TEXT")
  required    Boolean @default(false)
  placeholder String?
  helpText    String?
  options     String? // JSON-encoded options for SELECT type
  sortOrder   Int     @default(0)

  @@index([productId])
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

// status is a free-form string so the workflow can be configured later. Seeded
// values include: AWAITING_PAYMENT, AWAITING_REVIEW, PAYMENT_APPROVED,
// PROCESSING, NEEDS_INFO, COMPLETED, CANCELLED, RECEIPT_REJECTED
model Order {
  id             String    @id @default(cuid())
  trackingCode   String    @unique // public code for guest tracking
  userId         String? // null => guest order
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName   String
  customerPhone  String
  supportContact String? // optional messenger id/contact for delivery
  status         String    @default("AWAITING_PAYMENT")
  subtotal       Int       @default(0) // Toman, computed server-side
  discountAmount Int       @default(0)
  total          Int       @default(0)
  discountId     String?
  discount       Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  adminNote      String?
  customerNote   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  receipts      PaymentReceipt[]
  reviews       Review[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Immutable snapshot of what was purchased. Prices are snapshots computed on the
// server; browser-supplied prices are never trusted.
model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String? // may become null if product is later deleted
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String // snapshot at purchase time
  unitPrice      Int // snapshot, Toman
  quantity       Int      @default(1)
  lineTotal      Int // snapshot, Toman
  fieldResponses String? // JSON snapshot of checkout field answers

  @@index([orderId])
}

model OrderStatusHistory {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  note       String?
  actor      String? // "admin:<id>", "customer", or "system"
  createdAt  DateTime @default(now())

  @@index([orderId])
}

// status: "PENDING" | "APPROVED" | "REJECTED"
model PaymentReceipt {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  imagePath       String // stored file path/URL of uploaded receipt image
  status          String    @default("PENDING")
  rejectionReason String? // shown to the customer when rejected
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([orderId])
}

// ----------------------------------------------------------------------------
// Trust: reviews & testimonials
// ----------------------------------------------------------------------------

model Review {
  id              String   @id @default(cuid())
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  authorName      String? // used for admin testimonials or guest display name
  rating          Int      @default(5) // 1..5
  comment         String
  isVerifiedBuyer Boolean  @default(false)
  isTestimonial   Boolean  @default(false) // manually created by admin
  isApproved      Boolean  @default(false) // requires admin approval before publishing
  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([isApproved])
}

// ----------------------------------------------------------------------------
// Discounts
// ----------------------------------------------------------------------------

// type: "PERCENTAGE" | "FIXED"
model Discount {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  type           String    @default("PERCENTAGE")
  value          Int // percent (0-100) or fixed Toman amount
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  usageLimit     Int?
  usageCount     Int       @default(0)
  minOrderAmount Int? // Toman
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders Order[]

  @@index([isActive])
}

// ----------------------------------------------------------------------------
// Support
// ----------------------------------------------------------------------------

// status: "NEW" | "READ" | "RESOLVED"
model SupportMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String
  status    String   @default("NEW")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([status])
}

// ----------------------------------------------------------------------------
// Site settings (singleton) & content
// ----------------------------------------------------------------------------

// Singleton row enforced by a fixed id ("singleton").
model SiteSetting {
  id               String   @id @default("singleton")
  brandName        String   @default("Abol Store")
  successfulOrders Int      @default(0)
  cardHolderName   String? // demo only, no real bank data
  cardNumber       String? // demo only, no real bank data
  telegramUrl      String?
  rubikaUrl        String?
  supportText      String?
  updatedAt        DateTime @updatedAt
}

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String
  isPublished   Boolean   @default(false)
  featuredImage String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isPublished])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}
